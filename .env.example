# Copy to .env and edit. Never commit .env.
APP_VERSION=2.0.0-alpha.2

# REQUIRED: encrypts the AI key stored in the database. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later makes the stored AI key unreadable (re-enter it in Settings).
APP_SECRET_KEY=

# PostgreSQL account. Docker uses it for the db container; a native `uvicorn` or `pytest`
# builds DATABASE_URL from the same values (localhost:5432) unless DATABASE_URL is set.
POSTGRES_USER=valuation
POSTGRES_PASSWORD=change-me
POSTGRES_DB=valuation

# Optional: require "Authorization: Bearer <token>" on every API call.
# Set this before exposing the system beyond this computer.
APP_API_TOKEN=

# Where the web container listens. 127.0.0.1 = this computer only; 0.0.0.0 = your LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_HTTPS_PORT=8443

# :80 for local use; a domain name (e.g. valuation.example.com) for automatic HTTPS.
SITE_ADDRESS=:80

# Other frontends calling the API from another origin (apps, mini program dev tools), comma separated
CORS_ORIGINS=

APP_TIMEZONE=Asia/Macau
# Import valuations made with v1 (out/) on first start
APP_IMPORT_LEGACY=1
