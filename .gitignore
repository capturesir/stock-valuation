__pycache__/
*.pyc
.Python
.env
*.egg-info/
.venv/
.pytest_cache/

# local env and secrets
.env.*
*.pem

# local config (copy from config.example.yaml); never commit keys
config.yaml

# caches / venv
venv/

# local run output that may be regenerated
out/signals.json
out/signals/
out/signals.invalid.json

# local run history for the web 錯誤 panel
out/_run_history.json

# build / delivery artifacts
dist/

# request documents and delivery zips stay local; the source tree does not carry them
docs/*.docx
docs/*.zip

# per-user statement adjustments: local audit state, exported into each run's
# Excel「金額調整紀錄」and the calc JSON instead of being versioned here
cases/*/adjustments.json

# append-only per-run valuation log (R17–R20); rebuilt by running valuations
out/history/

# v2: runtime state (SQLite database, generated secret key) and frontend builds
var/
frontend/node_modules/
frontend/**/node_modules/
frontend/apps/*/dist/
frontend/packages/tokens/dist/
.env

# the template is safe to share (no secrets); keep it in the repo and the release zip
!.env.example
