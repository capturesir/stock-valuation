{
  "name": "stock-valuation-frontend",
  "version": "2.0.0-alpha.4",
  "private": true,
  "description": "估值工作台前端 monorepo：apps/*（各前端）與 packages/*（共用）",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:tokens": "pnpm --filter @sv/tokens build",
    "gen:api": "pnpm --filter @sv/api-client gen",
    "dev": "pnpm build:tokens && pnpm --filter @sv/web dev",
    "build": "pnpm build:tokens && pnpm --filter @sv/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
